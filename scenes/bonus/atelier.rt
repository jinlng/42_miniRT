# ─────────────────────────────────────────────────────────────────
#  "Atelier"  —  miniRT showcase scene
#
#  Layout (top-down):
#
#       [back wall]
#   (teal pillar)       (amber pillar)
#        [red matte]  [METAL]  [blue plastic]
#               (gold)   (violet)
#                    [camera]
#
#  Two lights:
#    warm key  — top-left,  sun-like,  high brightness
#    cool fill — top-right, moonlike,  low brightness
# ─────────────────────────────────────────────────────────────────

# ── scene globals ─────────────────────────────────────────────────
A 0.07 255,245,230

# ── camera ────────────────────────────────────────────────────────
C 0,12,-28 0,-0.28,1 54

# ── lights ────────────────────────────────────────────────────────
# warm key light — golden sun tone
L -28,38,-8 0.9 255,215,150

# cool fill light — moonlight tone, much softer
L 22,18,5 0.35 160,200,255

# ── floor & back wall ─────────────────────────────────────────────
pl 0,-4,0    0,1,0  190,185,180  0.04 12.0 0.0
pl 0,0,45    0,0,-1 148,145,158  0.03  8.0 0.0

# ── CENTER — large polished metal sphere ──────────────────────────
# high specular + high shininess = tight bright glint
sp 0,2,10    10  215,218,222  0.95 256.0 0.0

# ── SIDES — two contrasting materials ─────────────────────────────
# left: warm terracotta, almost matte
sp -12,0,8    6  205,78,52    0.10  8.0  0.0

# right: cobalt blue, plastic sheen
sp  12,0,8    6   48,108,210  0.65 64.0  0.0

# ── FRONT — two small accent spheres ──────────────────────────────
# gold: very shiny, slightly warm
sp  -5,-2,2   4  218,172,48   0.88 180.0 0.0

# violet: satin finish
sp   5,-2,2   4  142,68,208   0.75 120.0 0.0

# ── BACK — two pillars with sphere caps ───────────────────────────
# left pillar: teal
cy -20,8,22   0,1,0   4  24   88,148,118  0.35 48.0 0.0
sp -20,21,22   5   88,200,148  0.70 96.0 0.0

# right pillar: amber
cy  20,8,22   0,1,0   4  24   158,98,58   0.35 48.0 0.0
sp  20,21,22   5   210,145,82  0.70 96.0 0.0
