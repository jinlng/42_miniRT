# Camera
C 0,3,-20 0,0,1 70

# Ambient light
A 0.15 255,255,255

# Light
L -5,10,-10 1.0 255,255,255


# ===============================
# Material tests
# ===============================

# Tight metallic glint
# ks = 0.9
# shininess = 256
sp -8,2,5 8 180,180,220 0.9 256.0


# Broad plastic glow
# ks = 0.5
# shininess = 8
sp 0,2,5 8 220,80,80 0.5 8.0


# Matte surface
# ks = 0.0
# shininess = 32
sp 8,2,5 8 80,180,80 0.0 32.0


# Ground plane for reference
pl 0,0,0 0,1,0 120,120,120